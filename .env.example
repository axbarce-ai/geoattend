# Copy this file to .env and fill in real values.
# .env itself is gitignored -- never commit it.

# Server
PORT=3000
NODE_ENV=production

# Database (MySQL 8.0+ required -- deviceController.js uses ROW_NUMBER()
# OVER (...), a window function not available in MySQL 5.7)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_a_new_strong_password
DB_NAME=geoattend_pro

# A managed MySQL host (Aiven's free tier among them) requires an SSL/TLS
# connection and gives you a CA certificate to download -- point this at
# that file's path (see DEPLOYMENT.md Part 2 for exactly where Aiven puts
# it). Leave both commented out for a plain local MySQL.
# DB_SSL_CA=./aiven-ca.pem
# DB_SSL=true

# Auth -- generate real random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do NOT reuse the placeholder-looking defaults from an old .env, and do NOT
# reuse a JWT/session secret that was ever committed or shared anywhere.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
SESSION_SECRET=replace_with_a_different_long_random_secret

# Default admin seeded by database/seed.js -- log in once after deploying
# and change this password immediately (Settings > Admin Accounts).
DEFAULT_ADMIN_EMAIL=admin@my.cspc.edu.ph
DEFAULT_ADMIN_PASSWORD=replace_with_a_strong_temporary_password

# Google Maps (Google Cloud Console > APIs & Services > Credentials).
# Restrict this key to your deployed domain before going live.
GOOGLE_MAPS_API_KEY=

# Google Sign-In for the mobile app (Google Cloud Console > APIs & Services
# > Credentials > OAuth Client ID). Add your deployed URL to "Authorized
# JavaScript origins" for the Web client. Without this set, the mobile
# "Continue with Google" button shows a clear "not configured" error
# instead of silently failing.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Outgoing email (admin-account verification codes) through Brevo's HTTP API
# -- free tier, 300 emails/day, works on Render (which blocks SMTP). Create a
# key at Brevo > SMTP & API > API Keys, and verify MAIL_FROM_EMAIL under
# Senders. Unset on a dev server: codes are printed in the terminal instead.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=GeoAttend
# Alternative/fallback sender: Google Apps Script relay (scripts/mail-relay.gs
# -- setup steps are at the top of that file). Sends from the Google account
# that deployed it; no activation needed. Used when Brevo isn't set or fails.
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=

# Geofence accuracy tolerance in meters. The shipped default (500) is
# relaxed for desktop-browser testing -- lower to 50-100 before real
# deployment so a spoofed/inaccurate GPS reading can't pass as on-site.
ATTENDANCE_MAX_ACCURACY_METERS=100

# Face Verification (InsightFace "buffalo_l" via ONNX Runtime) -- leave
# commented out to use the defaults in models/, or override if you've
# placed the models somewhere else. See models/README.md.
# FACE_DETECTOR_MODEL_PATH=./models/det_10g.onnx
# FACE_DETECTOR_INPUT_SIZE=640
# FACE_DETECTOR_SCORE_THRESHOLD=0.5
# FACE_DETECTOR_NMS_THRESHOLD=0.4
# FACE_MODEL_PATH=./models/w600k_r50.onnx
# FACE_INPUT_SIZE=112
# FACE_MATCH_THRESHOLD=0.5
