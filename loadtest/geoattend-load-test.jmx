      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Public Page Visitors" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(PUBLIC_USERS,5)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(RAMP,30)}</stringProp>
